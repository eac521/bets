def either_player(df,pa,pb):
    '''
    Find either player to hit X value
    '''
    chk = df[df.name.isin([pa,pb])].T
    #either player
    return (1-(1-chk.iloc[-10:].sort_index(ascending=False).cumsum()).product(axis=1))


