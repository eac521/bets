        'shrinkage': (point_agg - boot_mean).mean(),
        'brier_point': ((point_agg - actual) ** 2).mean(),
        'brier_boot': ((boot_mean - actual) ** 2).mean(),
        'boot_uncertainty': boot_std.mean()
    })

agg_df = pd.DataFrame(agg_results)
